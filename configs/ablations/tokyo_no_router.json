{
  "experiment_group": "gigapixel-50mib-50e",
  "capacity": {
    "basis": "ingp_parameters"
  },
  "model": {
    "layers": 16,
    "base_resolution": 8,
    "max_resolution": 8192,
    "features": 2,
    "finest_features": 2,
    "router_enabled": false
  },
  "training": {
    "epochs": 50,
    "batch_size": 65536,
    "seed": 1729,
    "learning_rates": {
      "grid": 0.01,
      "router": 0.001,
      "decoder": 0.001
    },
    "lr_schedule": {
      "type": "late_cosine",
      "constant_through_epoch": 30,
      "minimum_factor": 0.1
    },
    "backend": "native",
    "epochs_per_stage": 1
  },
  "regions": {
    "selection": "error_per_parameter",
    "backend": "cuda_device"
  },
  "evaluation": {
    "interval": 5,
    "batch_size": 131072,
    "save_npy": false,
    "ssim": "off"
  },
  "ablation": "tokyo_no_router",
  "data": {
    "target_storage": "uint8",
    "sampling": "stratified"
  }
