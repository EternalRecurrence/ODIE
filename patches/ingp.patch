+	if args.stripe_rows:
+		# Gigapixel conversion otherwise creates full-size float RGB/RGBA arrays.
+		# Process rows to limit temporary NumPy allocations; the source decoder
+		# may still retain a full decoded image in memory.
+		# Preserve official RGB8 -> linear half4 math and the .bin layout.
+		# Input preparation only: no resizing, filtering, or training changes.
+		import struct
+		from PIL import Image
+		if args.stripe_rows < 1 or not args.output.endswith('.bin'):
+			raise ValueError('Stripe conversion requires positive rows and .bin output')
+		with Image.open(args.input) as source:
+			if source.mode != 'RGB':
+				raise ValueError('Stripe conversion expects original RGB8 input')
+			width, height = source.size
+			with open(args.output, 'xb') as stream:
+				stream.write(struct.pack('<ii', height, width))
+				for y in range(0, height, args.stripe_rows):
+					rgb = np.asarray(source.crop((0, y, width, min(y+args.stripe_rows, height))), dtype=np.float32)/255.
+					rgba = np.ones((*rgb.shape[:2], 4), dtype=np.float16)
+					rgba[..., :3] = common.srgb_to_linear(rgb).astype(np.float16)
+					stream.write(rgba.tobytes())
+		raise SystemExit(0)
